# ORBIT local configuration
ORBIT_LOG_LEVEL=INFO
ORBIT_PRIVACY_MODE=strict
ORBIT_ENABLE_DEMO_MODEL=true

# Optional OpenAI-compatible inference (remote or local)
# For local/self-hosted endpoints API key may be blank.
ORBIT_OPENAI_BASE_URL=
ORBIT_OPENAI_MODEL=
ORBIT_OPENAI_API_KEY=
ORBIT_OPENAI_RUNTIME_NAME=openai-compatible

# Optional llama.cpp OpenAI-compatible server
ORBIT_LLAMA_CPP_URL=
ORBIT_LLAMA_CPP_MODEL=

# Optional multimodal HTTP adapters
ORBIT_STT_URL=
ORBIT_VISION_URL=
ORBIT_MULTIMODAL_TIMEOUT=30

# Optional limits
ORBIT_RATE_LIMIT_PER_MINUTE=120
ORBIT_RATE_LIMIT_BURST=20
ORBIT_MAX_MEDIA_BYTES=26214400
